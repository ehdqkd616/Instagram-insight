# 회원가입 알림 메일 — config.py가 시작할 때 이 파일을 환경변수로 읽는다.
# 이 파일(.env)은 커밋하지 않는다. .env.example을 복사해서 값을 채운다.
# 가입이 들어오면 아래 주소로 승인 요청 메일을 보낸다 (쉼표로 여러 명).
# Gmail은 보내는 계정에서 2단계 인증을 켜고 "앱 비밀번호"를 SMTP_PASSWORD에 넣는다.
ADMIN_NOTIFY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 메일 속 "관리자 페이지에서 승인하기" 버튼이 가리킬 사이트 주소
PUBLIC_WEB_URL=http://localhost:5000
